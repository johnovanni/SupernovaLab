<Window x:Class="SupernovaLab.App.Windows.CloseUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        xmlns:r="clr-namespace:SupernovaLab.Rendering;assembly=SupernovaLab.Rendering"
        xmlns:text="clr-namespace:SupernovaLab.Core.Text;assembly=SupernovaLab.Core"
        Title="{Binding WindowTitle}" Width="900" Height="640" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontSize="13">
    <!-- DataContext: the CloseUpViewModel (spec §2.1's layout): the view on the left, the readouts column (with Notes) on the
         right, the pulse-trace row at the bottom (collapsed until the pulse trace exists, Task 8). -->
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_View" Foreground="{StaticResource TextBrush}">
                <MenuItem Header="_Grid" Foreground="Black" IsCheckable="True" IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.CloseUpGrid}"/>
                <MenuItem Header="_Field lines" Foreground="Black" IsCheckable="True" IsChecked="{Binding ShowFieldLines, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.FieldLines}"/>
                <MenuItem Header="_Light cylinder" Foreground="Black" IsCheckable="True" IsChecked="{Binding ShowLightCylinder, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.LightCylinder}"/>
                <MenuItem Header="_Cutaway" Foreground="Black" IsCheckable="True" IsChecked="{Binding IsCutaway, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.CloseUpCutaway}"/>
                <MenuItem Header="_Labels" Foreground="Black" IsCheckable="True" IsChecked="{Binding ShowLabels, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.CloseUpLabels}"/>
                <MenuItem Header="F_ocus view" Foreground="Black" IsCheckable="True" InputGestureText="F"
                          IsChecked="{Binding IsFocusView, Mode=TwoWay}" ToolTip="{x:Static text:Glossary.CloseUpFocusView}"/>
                <Separator/>
                <!-- Spec §2.5, ruling R-P3-9: the light-bending detail, remembered in layout.json; the notes name the level shown. -->
                <MenuItem Header="Light-bending _detail" Foreground="Black" ToolTip="{x:Static text:Glossary.CloseUpLightBendingDetail}">
                    <MenuItem Header="_Auto" Foreground="Black" IsCheckable="True" IsChecked="{Binding IsDetailAuto, Mode=TwoWay}"/>
                    <MenuItem Header="_Full" Foreground="Black" IsCheckable="True" IsChecked="{Binding IsDetailFull, Mode=TwoWay}"/>
                    <MenuItem Header="_Half" Foreground="Black" IsCheckable="True" IsChecked="{Binding IsDetailHalf, Mode=TwoWay}"/>
                    <MenuItem Header="_Quarter" Foreground="Black" IsCheckable="True" IsChecked="{Binding IsDetailQuarter, Mode=TwoWay}"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- The pulse trace (spec §4.4): a pulsar's or magnetar's pulses; collapsed until Task 8 draws it. -->
        <Border x:Name="PulseTraceRow" DockPanel.Dock="Bottom" Height="56" Margin="8,0,8,8" Visibility="Collapsed"
                Style="{StaticResource Panel}"/>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- The 3D close-up. DataContext: the CloseUpSceneController, set by the code-behind. -->
            <Border x:Name="ViewHost" Grid.Column="0" Background="#020308" ClipToBounds="True"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" ToolTip="{x:Static text:Glossary.CloseUpView}">
                <Grid x:Name="ViewGrid">
                    <r:TimedGLWpfControl x:Name="GlControl" Focusable="True"
                                     Visibility="{Binding IsFailed, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
                    <!-- Snapshot diagnostic only: the GL frame read back with GL.ReadPixels (no screen capture). -->
                    <Image x:Name="SnapshotImage" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"/>

                    <ItemsControl ItemsSource="{Binding RingLabels}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding XDip}"/>
                                <Setter Property="Canvas.Top" Value="{Binding YDip}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Opacity="{Binding Opacity}" Width="80" TextAlignment="Center"
                                           Margin="-40,-17,0,0" Foreground="#888780" FontSize="11"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Plan Task 6: the view's own labels ("To Earth" at the arrow's tip, "Light cylinder" on its ring). -->
                    <ItemsControl ItemsSource="{Binding ViewLabels}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding XDip}"/>
                                <Setter Property="Canvas.Top" Value="{Binding YDip}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6,-10,0,0" Padding="4,1" CornerRadius="3" Background="#99020308">
                                    <TextBlock Text="{Binding Text}" Foreground="#F2E27A" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Spec §2.1 and §4.3: a neutron star's speed label, and the key to its lines (colours schematic). -->
                    <Border Margin="6,4" Padding="6,3" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Left"
                            VerticalAlignment="Top" IsHitTestVisible="False"
                            Visibility="{Binding DataContext.SpeedLabel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DataContext.SpeedLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            <StackPanel Visibility="{Binding DataContext.ShowFieldLines, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Style="{StaticResource Muted}"><Run Text="━ " Foreground="#73A8FF"/><Run Text="closed field lines" Foreground="{StaticResource TextBrush}"/></TextBlock>
                                <TextBlock Style="{StaticResource Muted}"><Run Text="━ " Foreground="#FF9E4D"/><Run Text="open field lines (to the light cylinder)" Foreground="{StaticResource TextBrush}"/></TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}"
                                       Visibility="{Binding DataContext.State.ShowBeams, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}"><Run Text="▲ " Foreground="#99FFD9"/><Run Text="radio beams" Foreground="{StaticResource TextBrush}"/></TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Spec §6.5: the view's honest label, whenever a remnant is drawn. -->
                    <Border Margin="6,4" Padding="5,3" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Left"
                            VerticalAlignment="Bottom" IsHitTestVisible="False"
                            Visibility="{Binding DataContext.HasRemnant, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding DataContext.NoTelescopeNote, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource Muted}" Foreground="{StaticResource TextBrush}"/>
                    </Border>

                    <Border Margin="6,4" Padding="6,3" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <WrapPanel>
                            <Button Content="Auto-frame (Home)" Click="OnAutoFrameClick" Padding="6,1" Margin="0,0,8,0"
                                    Visibility="{Binding IsAutoFraming, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
                            <TextBlock Text="Drag to turn · wheel to zoom" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </WrapPanel>
                    </Border>

                    <!-- Spec §2.3: an outcome with no compact remnant says why. -->
                    <Border MaxWidth="420" Padding="14,10" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                            Visibility="{Binding DataContext.HasRemnant, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                        <TextBlock Text="{Binding DataContext.NoRemnantMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                   TextWrapping="Wrap" FontSize="14"/>
                    </Border>

                    <!-- Spec §8.4: no OpenGL 4.1, the requirement is named and the readouts keep working. -->
                    <Border Visibility="{Binding IsFailed, Converter={StaticResource VisibleWhen}}" MaxWidth="420" Padding="14,10"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding FailureMessage}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- The readouts (spec §2.1): each number with its confidence badge, its source on hover; then the notes. -->
            <Border Grid.Column="1" Width="270" Margin="8,0,0,0" Style="{StaticResource Panel}" Padding="10,8"
                    Visibility="{Binding IsFocusView, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <ItemsControl ItemsSource="{Binding Readouts}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="{Binding Label}" Style="{StaticResource Muted}" ToolTip="{Binding LabelToolTip}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding ValueText}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ContentPresenter ContentTemplate="{StaticResource PublishedBadge}" Content="{Binding}"/>
                                            <ContentPresenter ContentTemplate="{StaticResource ConfidenceBadge}" Content="{Binding}" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Header="Notes" Margin="0,10,0,0" IsExpanded="{Binding IsNotesExpanded, Mode=TwoWay}"
                                  Foreground="{StaticResource TextBrush}">
                            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
