<Window x:Class="SupernovaLab.App.Windows.CloseUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        xmlns:r="clr-namespace:SupernovaLab.Rendering;assembly=SupernovaLab.Rendering"
        xmlns:text="clr-namespace:SupernovaLab.Core.Text;assembly=SupernovaLab.Core"
        xmlns:views="clr-namespace:SupernovaLab.App.Views"
        Title="{Binding WindowTitle}" Width="900" Height="640" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontSize="13">
    <Window.Resources>
        <!-- One readout: its label (tooltip), the value, and the confidence badges; shared by the column's rows and the cutaway's. -->
        <DataTemplate x:Key="ReadoutRowTemplate">
                                    <Grid Margin="0,3,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="{Binding Label}" Style="{StaticResource Muted}" ToolTip="{Binding LabelToolTip}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding ValueText}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ContentPresenter ContentTemplate="{StaticResource PublishedBadge}" Content="{Binding}"/>
                                            <ContentPresenter ContentTemplate="{StaticResource ConfidenceBadge}" Content="{Binding}" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
        </DataTemplate>
        <!-- Task 18: a volume slider that cannot act (the sound is off) is dimmed, so it does not look broken. -->
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!-- DataContext: the CloseUpViewModel (spec §2.1's layout): the view on the left, the readouts column (with Notes) on the
         right, the pulse-trace row at the bottom (collapsed until the pulse trace exists, Task 8). -->
    <!-- Task 13: the guided tour brightens this outline frame at a Close-up stop (as it brightens an instrument panel's outline). -->
    <!-- Task 14's launch: the transparent default is the style's setter, not a local value, which the trigger could never override. -->
    <Border x:Name="TourOutline" BorderThickness="3">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Main.Tour.HighlightCloseUp}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_View" Foreground="{StaticResource TextBrush}">
                <MenuItem Header="_Grid" Foreground="Black" IsCheckable="True" IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.CloseUpGrid}"/>
                <MenuItem Header="_Field lines" Foreground="Black" IsCheckable="True" IsChecked="{Binding ShowFieldLines, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.FieldLines}"/>
                <MenuItem Header="_Light cylinder" Foreground="Black" IsCheckable="True" IsChecked="{Binding ShowLightCylinder, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.LightCylinder}"/>
                <MenuItem Header="_Cutaway" Foreground="Black" IsCheckable="True" IsChecked="{Binding IsCutaway, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.CloseUpCutaway}"/>
                <MenuItem Header="_Labels" Foreground="Black" IsCheckable="True" IsChecked="{Binding ShowLabels, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.CloseUpLabels}"/>
                <MenuItem Header="F_ocus view" Foreground="Black" IsCheckable="True" InputGestureText="F"
                          IsChecked="{Binding IsFocusView, Mode=TwoWay}" ToolTip="{x:Static text:Glossary.CloseUpFocusView}"/>
                <!-- Spec §4.4: the pulsar's sound, off by default; the pulse trace shows the speaker's state and the volume. -->
                <MenuItem Header="_Sound (pulsar clicks)" Foreground="Black" IsCheckable="True" IsChecked="{Binding IsSoundOn, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.CloseUpSound}"/>
                <Separator/>
                <!-- Spec §2.5, ruling R-P3-9: the light-bending detail, remembered in layout.json; the notes name the level shown. -->
                <MenuItem Header="Light-bending _detail" Foreground="Black" ToolTip="{x:Static text:Glossary.CloseUpLightBendingDetail}">
                    <MenuItem Header="_Auto" Foreground="Black" IsCheckable="True" IsChecked="{Binding IsDetailAuto, Mode=TwoWay}"/>
                    <MenuItem Header="_Full" Foreground="Black" IsCheckable="True" IsChecked="{Binding IsDetailFull, Mode=TwoWay}"/>
                    <MenuItem Header="_Half" Foreground="Black" IsCheckable="True" IsChecked="{Binding IsDetailHalf, Mode=TwoWay}"/>
                    <MenuItem Header="_Quarter" Foreground="Black" IsCheckable="True" IsChecked="{Binding IsDetailQuarter, Mode=TwoWay}"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Task 15 (the owner could not tell the sound was on): while the sound is on, its state shows here for every outcome, with the
             reason for any silence ("silent: no pulsar in this outcome", "silent until the pulsar's pulses reach Earth (10 years)") and
             the volume; the pulse-trace row below exists only for a pulsar or magnetar. -->
        <!-- Task 18: always shown; the speaker is a labelled button (it was a picture, and the owner's clicks on it did nothing). -->
        <Border x:Name="SoundStatusRow" DockPanel.Dock="Top" Margin="8,4,8,0" Padding="8,3" Style="{StaticResource Panel}"
                ToolTip="{x:Static text:Glossary.CloseUpSound}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding ToggleSoundCommand}" Margin="0,0,10,0" Padding="8,3" VerticalAlignment="Center"
                        ToolTip="{x:Static text:Glossary.CloseUpSoundButton}" AutomationProperties.Name="{Binding SoundButtonText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SpeakerGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,6,0"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SoundButtonText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Slider DockPanel.Dock="Right" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" Width="140" Margin="12,0,0,0"
                        VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.1" ToolTip="{x:Static text:Glossary.CloseUpVolume}"
                        IsEnabled="{Binding IsVolumeEnabled}" AutomationProperties.Name="Sound volume (top)"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SpeakerState}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               ToolTip="{Binding SpeakerStateToolTip}" AutomationProperties.Name="Sound state"/>
                    <!-- Task 16b (the owner): the rule, always in view while the sound is on. -->
                    <TextBlock Text="{x:Static text:Glossary.CloseUpSoundRule}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               AutomationProperties.Name="When the sound plays"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The pulse trace (spec §4.4): a pulsar's or magnetar's pulses, with the speaker's state and volume and the rates in words
             (nothing depends on hearing the sound). Shown for a pulsar or magnetar only. -->
        <Border x:Name="PulseTraceRow" DockPanel.Dock="Bottom" Height="84" Margin="8,0,8,8" Padding="10,6"
                Visibility="{Binding ShowPulseTrace, Converter={StaticResource VisibleWhen}}"
                Style="{StaticResource Panel}" ToolTip="{x:Static text:Glossary.CloseUpPulseTrace}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Width="230" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ToggleSoundCommand}" Margin="0,0,6,0" Padding="4,1" VerticalAlignment="Center"
                                ToolTip="{x:Static text:Glossary.CloseUpSoundButton}" AutomationProperties.Name="{Binding SoundButtonText}">
                            <TextBlock Text="{Binding SpeakerGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Button>
                        <TextBlock Text="{Binding SpeakerState}" Style="{StaticResource Muted}" Width="176" VerticalAlignment="Center"
                                   TextWrapping="Wrap" FontSize="11" ToolTip="{Binding SpeakerStateToolTip}" AutomationProperties.Name="Speaker state"/>
                    </StackPanel>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" Width="200" Margin="0,4,0,0" HorizontalAlignment="Left"
                            IsEnabled="{Binding IsVolumeEnabled}"
                            SmallChange="0.05" LargeChange="0.1" ToolTip="{x:Static text:Glossary.CloseUpVolume}" AutomationProperties.Name="Sound volume"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding TraceText}" FontWeight="SemiBold" Margin="0,0,0,3"
                               AutomationProperties.Name="Pulse trace"/>
                    <views:PulseTrace Grid.Row="1" x:Name="Trace"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- The 3D close-up. DataContext: the CloseUpSceneController, set by the code-behind. -->
            <Border x:Name="ViewHost" Grid.Column="0" Background="#020308" ClipToBounds="True"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" ToolTip="{x:Static text:Glossary.CloseUpView}">
                <Grid x:Name="ViewGrid">
                    <r:TimedGLWpfControl x:Name="GlControl" Focusable="True"
                                     Visibility="{Binding IsFailed, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
                    <!-- Snapshot diagnostic only: the GL frame read back with GL.ReadPixels (no screen capture). -->
                    <Image x:Name="SnapshotImage" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"/>

                    <ItemsControl ItemsSource="{Binding RingLabels}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding XDip}"/>
                                <Setter Property="Canvas.Top" Value="{Binding YDip}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Opacity="{Binding Opacity}" Width="80" TextAlignment="Center"
                                           Margin="-40,-17,0,0" Foreground="#888780" FontSize="11"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Plan Task 6: the view's own labels ("To Earth" at the arrow's tip, "Light cylinder" on its ring). -->
                    <ItemsControl ItemsSource="{Binding ViewLabels}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding XDip}"/>
                                <Setter Property="Canvas.Top" Value="{Binding YDip}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6,-10,0,0" Padding="4,1" CornerRadius="3" Background="#99020308">
                                    <TextBlock Text="{Binding Text}" Foreground="#F2E27A" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Spec §2.1 and §4.3: a neutron star's speed label, and the key to its lines (colours schematic). -->
                    <Border Margin="6,4" Padding="6,3" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Left"
                            VerticalAlignment="Top" IsHitTestVisible="False"
                            Visibility="{Binding DataContext.SpeedLabel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DataContext.SpeedLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            <StackPanel Visibility="{Binding DataContext.ShowFieldLines, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Style="{StaticResource Muted}"><Run Text="━ " Foreground="#73A8FF"/><Run Text="closed field lines" Foreground="{StaticResource TextBrush}"/></TextBlock>
                                <TextBlock Style="{StaticResource Muted}"><Run Text="━ " Foreground="#FF9E4D"/><Run Text="open field lines (to the light cylinder)" Foreground="{StaticResource TextBrush}"/></TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}"
                                       Visibility="{Binding DataContext.State.ShowBeams, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}"><Run Text="▲ " Foreground="#99FFD9"/><Run Text="radio beams" Foreground="{StaticResource TextBrush}"/></TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Plan Task 9 (spec §3.2): the first second's label ("From simulations") and its key (what each drawn thing is). -->
                    <Border Margin="6,4" Padding="6,3" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Left"
                            VerticalAlignment="Top" IsHitTestVisible="False"
                            Visibility="{Binding DataContext.StageLabel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DataContext.StageLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding DataContext.StageKey, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Muted}" Foreground="{StaticResource TextBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Plan Task 7 (spec §4.2): the cutaway's key. Colours are schematic; the layers' radii are to scale. -->
                    <Border Margin="6,4" Padding="6,4" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Right"
                            VerticalAlignment="Top" MaxWidth="250"
                            Visibility="{Binding DataContext.ShowCutawayKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="Layers (schematic colours)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <ItemsControl ItemsSource="{Binding DataContext.CutawayKey, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" ToolTip="{Binding ToolTip}">
                                            <Border Width="12" Height="12" Margin="0,1,6,0" VerticalAlignment="Top" BorderBrush="#66FFFFFF" BorderThickness="1"
                                                    Background="{Binding ColorHex}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="210" FontSize="11.5" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding Qualifier}" Style="{StaticResource Muted}" FontSize="10.5"
                                                           Visibility="{Binding Qualifier, Converter={StaticResource VisibleWhen}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Plan Task 7: the magnified strip of the outermost layers (deep at the left, the surface at the right). -->
                    <Border Margin="6,4,6,34" Padding="6,4" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Visibility="{Binding DataContext.ShowStrip, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DataContext.MagnifiedLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" ToolTip="{x:Static text:Glossary.MagnifiedStrip}"/>
                            <Grid Width="253" Height="26" Margin="0,3,0,0" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding DataContext.CutawayStrip, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding XDip}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding WidthDip}" Height="26" Background="{Binding ColorHex}" ToolTip="{Binding ToolTip}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- The drip line, and the atmosphere (a line at the surface end). -->
                                <Canvas>
                                    <Rectangle Canvas.Left="{Binding DataContext.CutawayDripXDip, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Width="2" Height="26" Fill="#5CF2FF" ToolTip="{x:Static text:Glossary.NeutronDrip}"/>
                                    <Rectangle Canvas.Left="250" Width="3" Height="26" Fill="#F2F0E6" ToolTip="{x:Static text:Glossary.NeutronStarAtmosphere}"/>
                                </Canvas>
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Foreground="{StaticResource TextBrush}"
                                       Text="{Binding DataContext.DripLabel, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Plan Task 7: before the crust forms, the cutaway's one label. -->
                    <Border Margin="6,4,6,34" Padding="6,3" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" IsHitTestVisible="True" ToolTip="{x:Static text:Glossary.ProtoNeutronStar}"
                            Visibility="{Binding DataContext.CutawayStateLabel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding DataContext.CutawayStateLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontWeight="SemiBold" Foreground="#FF9A4D"/>
                    </Border>

                    <!-- Task 20 (the owner: "a visible note in the closeup screen saying why the screen is opaque"): inside the star, inside
                         the opaque debris, and while the debris clears. -->
                    <Border Margin="6,4" Padding="8,5" CornerRadius="4" Background="#E0020308" HorizontalAlignment="Right"
                            VerticalAlignment="Top" MaxWidth="250" IsHitTestVisible="False" BorderBrush="#FF9A4D" BorderThickness="1"
                            Visibility="{Binding DataContext.State.ViewNote, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding DataContext.State.ViewNote, RelativeSource={RelativeSource AncestorType=Window}}"
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextBrush}" AutomationProperties.Name="Why the view is hidden"/>
                    </Border>

                    <!-- Spec §6.5: the view's honest label, whenever a remnant is drawn. -->
                    <Border Margin="6,4" Padding="5,3" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Left"
                            VerticalAlignment="Bottom" IsHitTestVisible="False"
                            Visibility="{Binding DataContext.HasRemnant, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding DataContext.NoTelescopeNote, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource Muted}" Foreground="{StaticResource TextBrush}"/>
                    </Border>

                    <Border Margin="6,4" Padding="6,3" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <WrapPanel>
                            <Button Content="Auto-frame (Home)" Click="OnAutoFrameClick" Padding="6,1" Margin="0,0,8,0"
                                    Visibility="{Binding IsAutoFraming, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
                            <TextBlock Text="Drag to turn · wheel to zoom" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </WrapPanel>
                    </Border>

                    <!-- Spec §2.3: an outcome with no compact remnant says why. -->
                    <Border MaxWidth="420" Padding="14,10" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                            Visibility="{Binding DataContext.HasRemnant, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                        <TextBlock Text="{Binding DataContext.NoRemnantMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                   TextWrapping="Wrap" FontSize="14"/>
                    </Border>

                    <!-- Spec §8.4: no OpenGL 4.1, the requirement is named and the readouts keep working. -->
                    <Border Visibility="{Binding IsFailed, Converter={StaticResource VisibleWhen}}" MaxWidth="420" Padding="14,10"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding FailureMessage}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- The readouts (spec §2.1): each number with its confidence badge, its source on hover; then the notes. -->
            <Border Grid.Column="1" Width="270" Margin="8,0,0,0" Style="{StaticResource Panel}" Padding="10,8"
                    Visibility="{Binding IsFocusView, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <ItemsControl ItemsSource="{Binding ReadoutViews}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="ReadoutRowTemplate"/>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Plan Task 7 (spec §4.2): the cutaway's numbers, each with its confidence and source. -->
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowCutawayKey, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="Cutaway" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            <ItemsControl ItemsSource="{Binding CutawayReadoutViews}" ItemTemplate="{StaticResource ReadoutRowTemplate}"/>
                        </StackPanel>
                        <Expander Header="Notes" Margin="0,10,0,0" IsExpanded="{Binding IsNotesExpanded, Mode=TwoWay}"
                                  Foreground="{StaticResource TextBrush}">
                            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Task 14: a note that names a term (ergosphere, ISCO, SASI, …) explains it on hover. -->
                                        <TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2"
                                                   ToolTip="{Binding Converter={StaticResource CloseUpTerm}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
    </Border>
</Window>
