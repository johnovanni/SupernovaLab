<Window x:Class="SupernovaLab.App.Windows.PresetInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:text="clr-namespace:SupernovaLab.Core.Text;assembly=SupernovaLab.Core"
        Title="Preset info" Width="720" Height="680" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontSize="13">
    <!-- DataContext: the shared MainViewModel. The selected preset's story, measurements and published values (spec §2.3, §5.0). -->
    <Window.Resources>
        <!-- A measurement: what was seen, the value, and where it was published. -->
        <DataTemplate x:Key="FactRow">
            <StackPanel Margin="0,3,0,6">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="12,1,0,0"/>
                <TextBlock Text="{Binding SourceText}" Style="{StaticResource Muted}" Margin="12,0,0,0"/>
            </StackPanel>
        </DataTemplate>
        <!-- A published value the lab pins; they share one citation, shown once below the list. -->
        <DataTemplate x:Key="PinRow">
            <TextBlock TextWrapping="Wrap" Margin="0,1">
                <Run Text="{Binding Label, Mode=OneWay}"/><Run Text=": " Foreground="{StaticResource MutedBrush}"/><Run
                     Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14,10,14,12">
        <TextBlock Text="No preset selected. Choose a real supernova from the dropdown at the top of the lab."
                   Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" ToolTip="{x:Static text:Glossary.Preset}"
                   Visibility="{Binding Lab.HasPreset, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding Lab.HasPreset, Converter={StaticResource VisibleWhen}}">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="{Binding Lab.SelectedPreset.Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Lab.SelectedPreset.Summary}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="What was actually seen" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Lab.SelectedPreset.WhatWasSeen}" TextWrapping="Wrap"/>

                <TextBlock Text="Measurements" Style="{StaticResource SectionTitle}"
                           Visibility="{Binding Lab.PresetFactRows, Converter={StaticResource VisibleWhen}}"/>
                <ItemsControl ItemsSource="{Binding Lab.PresetFactRows}" ItemTemplate="{StaticResource FactRow}"/>

                <TextBlock Text="Published values the lab uses" Style="{StaticResource SectionTitle}"
                           ToolTip="{x:Static text:Glossary.PublishedValue}"
                           Visibility="{Binding Lab.PresetPinRows, Converter={StaticResource VisibleWhen}}"/>
                <ItemsControl ItemsSource="{Binding Lab.PresetPinRows}" ItemTemplate="{StaticResource PinRow}"/>
                <TextBlock Text="{Binding Lab.PresetPinSourceText}" Style="{StaticResource Muted}" Margin="0,3,0,0"
                           Visibility="{Binding Lab.PresetPinSourceText, Converter={StaticResource VisibleWhen}}"/>

                <TextBlock Text="Distance and dust" Style="{StaticResource SectionTitle}" ToolTip="{x:Static text:Glossary.ObserverSource}"/>
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding Lab.DistanceText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=", "/><Run
                         Text="{Binding Lab.AvText, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Text="{Binding Lab.ObserverSourceText}" Style="{StaticResource Muted}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
