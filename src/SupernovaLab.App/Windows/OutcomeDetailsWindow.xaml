<Window x:Class="SupernovaLab.App.Windows.OutcomeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:text="clr-namespace:SupernovaLab.Core.Text;assembly=SupernovaLab.Core"
        Title="Outcome details" Width="820" Height="720" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontSize="13">
    <!-- DataContext: the shared MainViewModel. Every quantity of the outcome with its badge, range and source (spec §3). -->
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedRows" Source="{Binding Outcome.DetailRows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <DataTemplate x:Key="DetailRow">
            <Grid Margin="0,4,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock TextWrapping="Wrap" ToolTip="{Binding GlossaryKey, Converter={StaticResource GlossaryText}}">
                    <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                    <Run Text="  "/>
                    <Run Text="{Binding ValueNumber, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding ValueUnit, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,1,0,0">
                    <ContentPresenter ContentTemplate="{StaticResource PublishedBadge}" Content="{Binding}"/>
                    <ContentPresenter ContentTemplate="{StaticResource ConfidenceBadge}" Content="{Binding}" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Muted}"
                           Visibility="{Binding RangeText, Converter={StaticResource VisibleWhen}}">
                    <Run Text="Range: "/><Run Text="{Binding RangeText, Mode=OneWay}"/>
                </TextBlock>
                <!-- Pinned values share the citation given once at the top; drawn-curve rows the one under their heading. -->
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SourceLine}" Style="{StaticResource Muted}"
                           ToolTip="{Binding SourceText}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="14,10,14,12">
        <StackPanel DockPanel.Dock="Top" DataContext="{Binding Outcome}">
            <TextBlock FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap">
                <Run Text="{Binding TypeText, Mode=OneWay}" ToolTip="{Binding TypeToolTip}"/>
                <Run Text=" · " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding FateText, Mode=OneWay}"
                     ToolTip="{Binding FateToolTip}" FontSize="16" FontWeight="Normal"/><Run Text="{Binding FateSeparator, Mode=OneWay}"
                     Foreground="{StaticResource MutedBrush}" FontSize="16" FontWeight="Normal"/><Run Text="{Binding RemnantText, Mode=OneWay}"
                     ToolTip="{Binding RemnantToolTip}" FontSize="16" FontWeight="Normal"/>
            </TextBlock>
            <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding PublishedText}" Style="{StaticResource Muted}" Foreground="{StaticResource PublishedBrush}"
                       Margin="0,4,0,0" ToolTip="{x:Static text:Glossary.PublishedValue}"
                       Visibility="{Binding PublishedText, Converter={StaticResource VisibleWhen}}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                <Run Text="Badges: " /><Run Text="Established" Foreground="{StaticResource EstablishedBrush}"
                    ToolTip="{x:Static text:Glossary.Established}"/><Run Text=" · "/><Run Text="Model-dependent"
                    Foreground="{StaticResource ModelDependentBrush}" ToolTip="{x:Static text:Glossary.ModelDependent}"/><Run
                    Text=" · "/><Run Text="Speculative" Foreground="{StaticResource SpeculativeBrush}"
                    ToolTip="{x:Static text:Glossary.Speculative}"/><Run Text=". Hover a badge for its source."/>
            </TextBlock>
        </StackPanel>

        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedRows}}" ItemTemplate="{StaticResource DetailRow}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>

                <StackPanel Visibility="{Binding Outcome.CurveRows, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="From the drawn light curve" Style="{StaticResource SectionTitle}"
                               ToolTip="{x:Static text:Glossary.PeakBrightness}"/>
                    <TextBlock Text="{Binding Outcome.CurveSourceText}" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding Outcome.CurveRows}" ItemTemplate="{StaticResource DetailRow}"/>
                </StackPanel>

                <TextBlock Text="Notes" Style="{StaticResource SectionTitle}" ToolTip="{x:Static text:Glossary.Notes}"/>
                <ItemsControl ItemsSource="{Binding Outcome.Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="•" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
