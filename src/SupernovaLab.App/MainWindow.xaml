<Window x:Class="SupernovaLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SupernovaLab.App.Views"
        xmlns:text="clr-namespace:SupernovaLab.Core.Text;assembly=SupernovaLab.Core"
        Title="SupernovaLab" Width="1366" Height="768" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontSize="13">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_View" Foreground="{StaticResource TextBrush}">
                <MenuItem Header="_Instruments" Foreground="Black" Command="{Binding ShowInstrumentsCommand}"
                          ToolTip="{x:Static text:Glossary.Instruments}"/>
                <MenuItem Header="_Outcome details" Foreground="Black" Command="{Binding ShowOutcomeDetailsCommand}"
                          ToolTip="{x:Static text:Glossary.OutcomeDetails}"/>
                <MenuItem Header="_Preset info" Foreground="Black" Command="{Binding ShowPresetInfoCommand}"
                          ToolTip="{x:Static text:Glossary.PresetInfo}"/>
            </MenuItem>
        </Menu>

        <!-- Status line: e.g. that editing an input dropped a preset's published values. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0" Padding="10,2">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" MinHeight="15"/>
        </Border>

        <views:TimelineBar DockPanel.Dock="Bottom" DataContext="{Binding Timeline}" Margin="8,0,8,4"/>

        <!-- Reserved for the instrument strip (Task 15 replaces the placeholder). -->
        <Border x:Name="InstrumentStripHost" DockPanel.Dock="Bottom" Height="64" Margin="8,6,8,6"
                Style="{StaticResource Placeholder}" ToolTip="{x:Static text:Glossary.InstrumentStrip}">
            <TextBlock Text="Instrument strip: one tile per messenger (coming next)" Style="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Grid Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <views:LabPanel Grid.Column="0"/>

            <!-- The 3D view (Task 16 replaces the placeholder). -->
            <Border x:Name="SceneHost" Grid.Column="1" Margin="8,0" Style="{StaticResource Placeholder}"
                    ToolTip="{x:Static text:Glossary.SceneView}">
                <TextBlock Text="3D explosion view (coming later)" Style="{StaticResource Muted}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <views:OutcomeSummary Grid.Row="0"/>
                <views:OutcomeMapStrip Grid.Row="1" Margin="0,8,0,0"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
