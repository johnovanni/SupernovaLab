<Window x:Class="SupernovaLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SupernovaLab.App.Views"
        xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        xmlns:r="clr-namespace:SupernovaLab.Rendering;assembly=SupernovaLab.Rendering"
        xmlns:text="clr-namespace:SupernovaLab.Core.Text;assembly=SupernovaLab.Core"
        Title="SupernovaLab" Width="1366" Height="768" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontSize="13">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_View" Foreground="{StaticResource TextBrush}">
                <MenuItem Header="_Instruments" Foreground="Black" Command="{Binding ShowInstrumentsCommand}"
                          ToolTip="{x:Static text:Glossary.Instruments}"/>
                <MenuItem Header="_Outcome details" Foreground="Black" Command="{Binding ShowOutcomeDetailsCommand}"
                          ToolTip="{x:Static text:Glossary.OutcomeDetails}"/>
                <MenuItem Header="_Preset info" Foreground="Black" Command="{Binding ShowPresetInfoCommand}"
                          ToolTip="{x:Static text:Glossary.PresetInfo}"/>
                <MenuItem Header="Close-_up" Foreground="Black" Command="{Binding ShowCloseUpCommand}"
                          ToolTip="{x:Static text:Glossary.CloseUp}"/>
                <MenuItem Header="_Focus view" Foreground="Black" IsCheckable="True" InputGestureText="F"
                          IsChecked="{Binding Layout.IsFocusView, Mode=TwoWay}"
                          ToolTip="{Binding Layout.FocusToggleToolTip}"/>
                <MenuItem Header="Distance _rings" Foreground="Black" IsCheckable="True"
                          IsChecked="{Binding DataContext.ShowRings, ElementName=SceneHost, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.DistanceRings}"/>
                <MenuItem Header="_Cutaway" Foreground="Black" IsCheckable="True"
                          IsChecked="{Binding DataContext.IsCutaway, ElementName=SceneHost, Mode=TwoWay}"
                          ToolTip="{x:Static text:Glossary.Cutaway}"/>
                <MenuItem Header="_Quality" Foreground="Black"
                          ToolTip="How many debris particles the 3D view draws. It steps down by itself if the graphics card needs more than 20 ms to draw a frame (as measured by the card's own timer; the step-down is off where the card cannot time itself); a choice here starts it over.">
                    <MenuItem Header="_High (200,000 particles)" Foreground="Black" IsCheckable="True"
                              IsChecked="{Binding DataContext.IsQualityHigh, ElementName=SceneHost, Mode=TwoWay}"/>
                    <MenuItem Header="_Medium (100,000)" Foreground="Black" IsCheckable="True"
                              IsChecked="{Binding DataContext.IsQualityMedium, ElementName=SceneHost, Mode=TwoWay}"/>
                    <MenuItem Header="_Low (50,000)" Foreground="Black" IsCheckable="True"
                              IsChecked="{Binding DataContext.IsQualityLow, ElementName=SceneHost, Mode=TwoWay}"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Status line: e.g. that editing an input dropped a preset's published values. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0" Padding="10,2">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" MinHeight="15"/>
        </Border>

        <views:TimelineBar DockPanel.Dock="Bottom" DataContext="{Binding Timeline}" Margin="8,0,8,4"/>

        <!-- The instrument strip (spec §5.0): one tile per messenger; clicking a tile opens its panel. -->
        <views:InstrumentStrip DockPanel.Dock="Bottom" Height="64" Margin="8,6,2,6"
                               Visibility="{Binding Layout.ShowInstrumentStrip, Converter={StaticResource VisibleWhen}}"/>

        <Grid Margin="8,8,8,0">
            <!-- Task 15: the two side columns fold to a 20 px strip (or vanish in the Focus view); the code-behind sets their widths
                 from the layout view model (a ColumnDefinition is not in the visual tree, so it cannot bind to the data context). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LabColumn" Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="OutcomeColumn" Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <views:LabPanel Grid.Column="0" Visibility="{Binding Layout.ShowLabPanel, Converter={StaticResource VisibleWhen}}"/>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <Button VerticalAlignment="Top" Margin="1,3,1,0" Padding="0,2" FontSize="12" Content="{Binding Layout.LabToggleText}"
                            ToolTip="{Binding Layout.LabToggleToolTip}" Command="{Binding Layout.ToggleLabCommand}"/>
                </Border>
            </Grid>

            <!-- The 3D view (spec §6). DataContext: the SceneController, set by the code-behind. -->
            <Border x:Name="SceneHost" Grid.Column="1" Margin="8,0" Background="#020308" ClipToBounds="True"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                    ToolTip="{x:Static text:Glossary.SceneView}">
                <Grid x:Name="SceneGrid">
                    <r:TimedGLWpfControl x:Name="GlControl" Focusable="True"
                                     Visibility="{Binding IsFailed, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
                    <!-- Snapshot diagnostic only: the GL frame read back with GL.ReadPixels (ruling R19). -->
                    <Image x:Name="SnapshotImage" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"/>

                    <!-- The distance rings' labels (plan ruling P6): WPF text placed from the GL projection, at each ring's top. -->
                    <ItemsControl ItemsSource="{Binding RingLabels}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding XDip}"/>
                                <Setter Property="Canvas.Top" Value="{Binding YDip}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Opacity="{Binding Opacity}" Width="80" TextAlignment="Center"
                                           Margin="-40,-17,0,0" Foreground="#888780" FontSize="11"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Task 15: one overlay grid over the 3D view (it has no background, so drags and the wheel pass through the gaps):
                         row 0 the readout and notes, row 1 the tour caption on a cutaway stop, row 3 the caption on any other stop, row 4 the key and the hint. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Task 11: a translucent dark backdrop keeps the readout and notes legible over bright shells. Final review I8: the
                             readout and the notes each take at most half the view's width (two equal columns of a background-less grid,
                             which passes drags and wheel through), so they cannot overlap at the 1,100 px minimum window width. -->
                        <Grid Grid.Row="0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="6,4" Padding="5,3" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Left"
                                VerticalAlignment="Top" IsHitTestVisible="False">
                            <StackPanel>
                                <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RadiusText}" Margin="0,2,0,0" MaxWidth="340" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="6,4" Padding="6,4" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotesText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding NotesDisplayText}" Style="{StaticResource Muted}" Foreground="{StaticResource TextBrush}"
                                           MaxWidth="320" TextAlignment="Right" TextWrapping="Wrap" IsHitTestVisible="False"/>
                                <TextBlock Text="{Binding NotesToggleText}" Foreground="{StaticResource AccentBrush}" FontSize="11.5" Cursor="Hand"
                                           TextAlignment="Right" Margin="0,3,0,0" ToolTip="Show or hide the other notes">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding ToggleNotesCommand}"/>
                                    </TextBlock.InputBindings>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NotesToggleText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        </Grid>

                        <!-- Task 13: the guided tour's caption. Task 15: on a cutaway stop it sits at the top edge of the view (row 1, below the
                             readout and notes) so it does not cover the slice; otherwise at the bottom (row 3, above the key and the hint). It folds
                             to a one-line bar; a click on it resumes a paused tour. Hover shows the source and confidence of each sentence.
                             DataContext: the main view model's Tour. A press on the panel does not start a drag of the view. -->
                        <Border DataContext="{Binding DataContext.Tour, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding IsActive, Converter={StaticResource VisibleWhen}}"
                                HorizontalAlignment="Center" Margin="8,8,8,0" MaxWidth="400" Padding="10,7"
                                CornerRadius="6" Background="#E6020308" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                MouseDown="OnTourPanelMouseDown" ToolTipService.IsEnabled="{Binding HasSources}"
                                ToolTipService.ShowDuration="60000">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Grid.Row" Value="3"/>
                                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CaptionAtTop}" Value="True">
                                            <Setter Property="Grid.Row" Value="1"/>
                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="{Binding PlacementTarget.DataContext.SourceText, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                               MaxWidth="520" TextWrapping="Wrap"/>
                                </ToolTip>
                            </Border.ToolTip>
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Content="{Binding CollapseToggleText}" ToolTip="{Binding CollapseToolTip}"
                                            Command="{Binding ToggleCaptionCommand}" Padding="5,0" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CounterText}" Style="{StaticResource Muted}" FontSize="11.5"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Guided tour" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                               ToolTip="{x:Static text:Glossary.GuidedTour}" VerticalAlignment="Center"
                                               Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhen}}"/>
                                    <TextBlock Text="{Binding CollapsedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Visibility="{Binding IsCollapsed, Converter={StaticResource VisibleWhen}}"/>
                                </DockPanel>
                                <StackPanel Margin="0,4,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="{Binding Caption}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="Previous" Command="{Binding PreviousCommand}" Padding="8,1" Margin="0,0,6,0"/>
                                        <Button Content="Pause" Command="{Binding PauseCommand}" Padding="8,1" Margin="0,0,6,0"
                                                Visibility="{Binding ShowResume, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
                                        <Button Content="Resume tour" Command="{Binding ResumeCommand}" Padding="8,1" Margin="0,0,6,0"
                                                Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                                Visibility="{Binding ShowResume, Converter={StaticResource VisibleWhen}}"/>
                                        <Button Content="Next" Command="{Binding NextCommand}" Padding="8,1" Margin="0,0,6,0"/>
                                        <Button Content="Exit" Command="{Binding ExitCommand}" Padding="8,1"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                            <!-- The key (bottom left, in the row above the caption so nothing overlaps it; its list scrolls when the view is short): the element layers the cut faces show now, and the shock shells while they are drawn. -->
                            <Border Grid.Row="2" Margin="6,4" Padding="5,3" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Left" MaxWidth="330"
                                    VerticalAlignment="Bottom" IsHitTestVisible="True"
                                    Visibility="{Binding ShowKey, Converter={StaticResource VisibleWhen}}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <!-- Task 15: the key folds to this "Key" tab, as the notes fold to "{n} more notes". -->
                                <TextBlock Text="{Binding DataContext.Layout.KeyToggleText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource AccentBrush}" FontSize="11.5" Cursor="Hand"
                                           ToolTip="Fold or unfold the colour key" Margin="0,0,0,1">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.Layout.ToggleKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding DataContext.Layout.IsKeyFolded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
<StackPanel>
                                <StackPanel Visibility="{Binding ShowShellKey, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,2">
                                    <DockPanel Margin="0,1" ToolTip="{x:Static text:Glossary.ForwardShock}">
<Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0" BorderThickness="2"
                                                BorderBrush="{Binding ForwardShellHex}"/>
<TextBlock TextWrapping="Wrap" Text="Swept-up gas; forward shock at its edge" Style="{StaticResource Muted}"/>
</DockPanel>
                                    <DockPanel Margin="0,1" ToolTip="{x:Static text:Glossary.ContactSurface}">
<Border DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,6,0"/>
<TextBlock TextWrapping="Wrap" Text="Contact surface: the shell's inner edge" Style="{StaticResource Muted}"/>
</DockPanel>
                                    <DockPanel Margin="0,1" ToolTip="{x:Static text:Glossary.ReverseShock}">
<Border DockPanel.Dock="Left" Width="12" Height="3" Margin="0,0,6,0" VerticalAlignment="Center"
                                                Background="{Binding ReverseShellHex}"/>
<TextBlock TextWrapping="Wrap" Text="Reverse shock; debris behind it drawn hot" Style="{StaticResource Muted}"/>
</DockPanel>
                                </StackPanel>
                                <DockPanel Margin="0,1" ToolTip="{x:Static text:Glossary.PulsarWindNebula}"
                                            Visibility="{Binding ShowNebulaKey, Converter={StaticResource VisibleWhen}}">
<Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0" Background="{Binding NebulaHex}"/>
<TextBlock TextWrapping="Wrap" Text="Pulsar wind nebula" Style="{StaticResource Muted}"/>
</DockPanel>
                                <DockPanel Margin="0,1" ToolTip="{x:Static text:Glossary.Sn1987aRings}"
                                            Visibility="{Binding ShowSn1987aRingsKey, Converter={StaticResource VisibleWhen}}">
<Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0" BorderThickness="2" BorderBrush="{Binding Sn1987aRingsHex}"/>
<TextBlock TextWrapping="Wrap" Text="SN 1987A's rings (observed)" Style="{StaticResource Muted}"/>
</DockPanel>
                                <ItemsControl ItemsSource="{Binding Legend}" ToolTip="{x:Static text:Glossary.Cutaway}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
<Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="2" Margin="0,0,6,0" Background="{Binding ColorHex}"/>
<TextBlock TextWrapping="Wrap" Text="{Binding Name}" Style="{StaticResource Muted}"/>
</DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,1" ToolTip="{x:Static text:Glossary.ShockInStar}"
                                            Visibility="{Binding ShowShockKey, Converter={StaticResource VisibleWhen}}">
<Border DockPanel.Dock="Left" Width="12" Height="3" Margin="0,0,6,0" Background="White" VerticalAlignment="Center"/>
<TextBlock TextWrapping="Wrap" Text="Shock front" Style="{StaticResource Muted}"/>
</DockPanel>
                                <TextBlock Text="Fingers: mixing from the core" Style="{StaticResource Muted}" Margin="0,1"
                                           ToolTip="{x:Static text:Glossary.MixingFingers}"
                                           Visibility="{Binding ShowFingerKey, Converter={StaticResource VisibleWhen}}"/>
                            </StackPanel></ScrollViewer>
                            </Grid>
                            </Border>
                            <!-- The hint and Home button share the notes' backdrop, so they stay legible over bright debris. -->
                            <Border Grid.Row="4" Margin="6,4" Padding="6,3" CornerRadius="4" Background="#CC020308" HorizontalAlignment="Right" MaxWidth="260"
                                    VerticalAlignment="Bottom">
                                <WrapPanel>
                                    <Button Content="Auto-frame (Home)" Click="OnAutoFrameClick" Padding="6,1" Margin="0,0,8,0"
                                            Visibility="{Binding IsAutoFraming, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
                                    <!-- Task 15: the Focus view (key F) hides the side columns and the instrument strip. -->
                                    <Button Content="{Binding DataContext.Layout.FocusToggleText, RelativeSource={RelativeSource AncestorType=Window}}" Padding="6,1" Margin="0,0,8,0"
                                            ToolTip="{Binding DataContext.Layout.FocusToggleToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Command="{Binding DataContext.Layout.ToggleFocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBlock Text="Drag to turn · wheel to zoom" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </WrapPanel>
                            </Border>
                    </Grid>

                    <Border Visibility="{Binding IsFailed, Converter={StaticResource VisibleWhen}}" MaxWidth="420" Padding="14,10"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding FailureMessage}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <Button VerticalAlignment="Top" Margin="1,3,1,0" Padding="0,2" FontSize="12" Content="{Binding Layout.OutcomeToggleText}"
                            ToolTip="{Binding Layout.OutcomeToggleToolTip}" Command="{Binding Layout.ToggleOutcomeCommand}"/>
                </Border>
                <Grid Grid.Column="1" Visibility="{Binding Layout.ShowOutcomeColumn, Converter={StaticResource VisibleWhen}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <views:OutcomeSummary Grid.Row="0"/>
                    <views:OutcomeMapStrip Grid.Row="1" Margin="0,8,0,0"/>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
