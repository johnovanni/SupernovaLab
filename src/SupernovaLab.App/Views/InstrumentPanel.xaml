<UserControl x:Class="SupernovaLab.App.Views.InstrumentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:text="clr-namespace:SupernovaLab.Core.Text;assembly=SupernovaLab.Core">
    <!-- DataContext: an InstrumentPanelViewModel (spec §5.1). Shared chrome: title, sub-tabs, instrument picker, detection
         and confidence badges, the plot (with the "now" cursor overlaid) and the notes. -->
    <Border Style="{StaticResource Panel}" Padding="8,5,8,5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title, confidence badge, detection badge. -->
            <Grid x:Name="Header" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding TitleToolTip}"/>
                <Border Grid.Column="1" CornerRadius="3" Padding="5,0,5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Background="{Binding Confidence, Converter={StaticResource ConfidenceBrush}}"
                        ToolTip="{Binding ConfidenceToolTip}">
                    <TextBlock Text="{Binding Confidence, Converter={StaticResource ConfidenceText}}" FontSize="10.5"
                               FontWeight="SemiBold" Foreground="{StaticResource BadgeTextBrush}"/>
                </Border>
                <Border Grid.Column="2" CornerRadius="3" Padding="5,0,5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Background="{Binding CurrentDetection.Status, Converter={StaticResource DetectionBrush}}"
                        ToolTip="{Binding DetectionToolTip}">
                    <TextBlock x:Name="DetectionBadgeText" Text="{Binding DetectionText}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BadgeTextBrush}"/>
                </Border>
            </Grid>

            <!-- Sub-tabs and the instrument picker. -->
            <Grid Grid.Row="1" Margin="0,4,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox ItemsSource="{Binding SubTabs}" SelectedItem="{Binding SelectedSubTab}" Style="{StaticResource SubTabStrip}"/>
                <ComboBox Grid.Column="1" Width="150" Margin="6,0,0,0" VerticalAlignment="Top" FontSize="11.5"
                          ItemsSource="{Binding InstrumentChoices}" SelectedItem="{Binding SelectedInstrumentChoice}"
                          ToolTip="{Binding SelectedInstrumentChoice.ToolTip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" ToolTip="{Binding ToolTip}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- The plot, with the cursor overlaid (moving it never re-renders the plot). -->
            <Grid Grid.Row="2" MinHeight="90">
                <sp:WpfPlot x:Name="Plot"/>
                <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True">
                    <Line x:Name="CursorLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Visibility="Collapsed"/>
                    <TextBlock x:Name="CursorEdge" FontSize="10.5" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                </Canvas>
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource SpeculativeBrush}" TextWrapping="Wrap"
                           FontSize="12" Margin="40,20" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ErrorText, Converter={StaticResource VisibleWhen}}"/>
            </Grid>

            <!-- Legend: drawn in WPF so it never covers the curves. -->
            <ItemsControl Grid.Row="3" x:Name="Legend" Margin="0,2,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                            <Rectangle Width="12" Height="2" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Visibility="{Binding Marker, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
                            <Ellipse Width="6" Height="6" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="3,0,5,0"
                                     Visibility="{Binding Marker, Converter={StaticResource VisibleWhen}}"/>
                            <TextBlock Text="{Binding Text}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Readout or "not modeled here", the view's note, the visible panel's comparisons, the preset's facts. -->
            <StackPanel Grid.Row="4" Margin="0,2,0,0">
                <TextBlock Text="{Binding PlotNote}" Style="{StaticResource Warning}" FontSize="11"
                           Visibility="{Binding PlotNote, Converter={StaticResource VisibleWhen}}"/>
                <TextBlock Text="{Binding CurrentValueText}" FontSize="11.5" TextWrapping="Wrap"
                           Visibility="{Binding CurrentValueText, Converter={StaticResource VisibleWhen}}"/>
                <TextBlock Text="{Binding SummaryText}" FontSize="11.5" TextWrapping="Wrap"
                           ToolTip="{x:Static text:Glossary.ApparentMagnitude}"
                           Visibility="{Binding SummaryText, Converter={StaticResource VisibleWhen}}"/>
                <TextBlock Text="{Binding PanelNote}" Style="{StaticResource Muted}" FontSize="10.5" MaxHeight="42"
                           TextTrimming="WordEllipsis" ToolTip="{Binding PanelNote}"
                           Visibility="{Binding PanelNote, Converter={StaticResource VisibleWhen}}"/>
                <ScrollViewer MaxHeight="44" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding FactNotes, Converter={StaticResource VisibleWhen}}"
                              ToolTip="{x:Static text:Glossary.Preset}">
                    <ItemsControl ItemsSource="{Binding FactNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" FontSize="10.5" TextWrapping="Wrap" Margin="0,1,2,0"
                                           Foreground="{StaticResource PublishedBrush}" ToolTip="{Binding SourceText}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
