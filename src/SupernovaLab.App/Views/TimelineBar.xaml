<UserControl x:Class="SupernovaLab.App.Views.TimelineBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:SupernovaLab.Core.Text;assembly=SupernovaLab.Core">
    <!-- DataContext: TimelineViewModel. Spec §4: Play/Pause, a log scrubber with event markers, speed, time readouts. -->
    <Border Style="{StaticResource Panel}" Padding="10,4,10,3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Controls and readouts. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}" Width="64" Margin="0,0,10,0"/>
                <!-- Task 13: the guided tour (this bar's DataContext is the timeline; the tour is the main window's). -->
                <Button Grid.Column="1" Content="Tour" Width="56" Margin="0,0,10,0"
                        Command="{Binding DataContext.Tour.TourCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{x:Static text:Glossary.GuidedTour}"/>
                <TextBlock Grid.Column="2" Text="{Binding ObserverTimeText}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" ToolTip="{x:Static text:Glossary.ObserverTime}"/>
                <TextBlock Grid.Column="3" Text="{Binding LightLeftText}" Style="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="16,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip="{x:Static text:Glossary.LightTravelTime}"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" ToolTip="{x:Static text:Glossary.PlaybackSpeed}">
                    <TextBlock Text="Speed" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                    <Slider Width="120" Minimum="0.1" Maximum="3" Value="{Binding DecadesPerSecond}" VerticalAlignment="Center"
                            SmallChange="0.05" LargeChange="0.25"/>
                    <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Muted}" FontSize="11.5" Width="215"
                               Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                </StackPanel>
            </Grid>

            <!-- Marker labels, placed by TimelineViewModel.LayoutMarkerLabels in three rows without overlaps; a label
                 with no room is hidden, and its tick below keeps the tooltip and the jump. -->
            <Grid Grid.Row="1" Margin="5,3,5,0" Height="39" x:Name="Track" SizeChanged="OnTrackSizeChanged">
                <ItemsControl ItemsSource="{Binding MarkerLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="{Binding Width}" Padding="0" Margin="0" Background="Transparent" BorderThickness="0"
                                    Command="{Binding DataContext.JumpToMarkerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Marker}" ToolTip="{Binding Marker.ToolTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{Binding Marker.Label}" FontSize="10.5" Foreground="{StaticResource AccentBrush}"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" Background="Transparent"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- The scrubber (log time) with the marker ticks over it. -->
            <Grid Grid.Row="2">
                <Slider Minimum="0" Maximum="1" Value="{Binding ScrubFraction}" SmallChange="0.002" LargeChange="0.02"
                        Margin="0" ToolTip="{x:Static text:Glossary.LogTimeline}"/>
                <Grid Margin="5,0" x:Name="TickTrack">
                    <ItemsControl ItemsSource="{Binding Markers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource FractionToOffset}" ConverterParameter="3">
                                            <Binding Path="Fraction"/>
                                            <Binding Path="ActualWidth" ElementName="TickTrack"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="6" Height="9" Padding="0" Margin="0" Cursor="Hand" ToolTip="{Binding ToolTip}"
                                        Command="{Binding DataContext.JumpToMarkerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <Rectangle Width="2" Fill="{StaticResource AccentBrush}" Opacity="0.9"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <!-- Round times under the scrubber. -->
            <Grid Grid.Row="3" Margin="5,0" Height="14" x:Name="AxisTrack">
                <ItemsControl ItemsSource="{Binding AxisLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource CenteredLabelOffset}" ConverterParameter="56">
                                        <Binding Path="Fraction"/>
                                        <Binding Path="ActualWidth" ElementName="AxisTrack"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Width="56" TextAlignment="Center" Style="{StaticResource Muted}" FontSize="10.5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</UserControl>
