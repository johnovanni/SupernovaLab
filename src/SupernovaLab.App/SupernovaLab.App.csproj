<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\SupernovaLab.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- ScottPlot.WPF 5.1.59 pulls SkiaSharp.Views.WPF, which ships net462-net481 assets only; it works under WPF on net8. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SupernovaLab.Rendering\SupernovaLab.Rendering.csproj" />
    <ProjectReference Include="..\SupernovaLab.Core\SupernovaLab.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SupernovaLab.ico" />
  </ItemGroup>

</Project>
